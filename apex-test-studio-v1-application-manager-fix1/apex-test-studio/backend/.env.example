# Copy this file to .env (same folder) and paste your PostgreSQL connection string.
# Works with Neon / Supabase / any PostgreSQL. NEVER commit the real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# optional
# APEX_BASE=https://oracleapex.com/ords/r/abhi13_workspace/timesheet-app
# KEEP_RUNS=8          # newest runs kept in the DB (videos are big; Neon free tier = 0.5 GB)
# DB_LIMIT_MB=512      # only used for the storage meter in the UI
