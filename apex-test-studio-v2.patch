+            vault.parse("env:" + name)
+        except vault.CredentialError as exc:
+            raise ApiError(400, str(exc))
+        if ref.startswith("vault:"):
+            vault.delete(ref)
+        ref = "env:" + name
+    elif mode == "vault":
+        pw = cred.get("password")
